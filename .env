DB_ENGINE=django.db.backends.postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=skin
DB_USER=postgres
DB_PASS=fpf2025

# Variáveis do MinIO - Alinhadas com settings.py e docker-compose.yml
MINIO_ACCESS_KEY=minioadmin # Deve ser o mesmo que MINIO_ROOT_USER no docker-compose.yml
MINIO_SECRET_KEY=minioadmin # Deve ser o mesmo que MINIO_ROOT_PASSWORD no docker-compose.yml
MINIO_BUCKET_NAME=skinhealthai-bucket # Nome do bucket que você vai usar
MINIO_ENDPOINT_URL=http://minio:9000 # Nome do serviço MinIO no docker-compose.yml e sua porta

# Variáveis gerais do Django (recomendado)
DJANGO_SECRET_KEY=sua_secret_key_aqui_gerada_randomicamente # Gere uma com 'python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"'
DJANGO_DEBUG=True # Ou False para produção